# =================================================================
# PerturbMat-Agent Environment Configuration
# Copy this file to .env and fill in your API keys:
# cp .env.example .env
# =================================================================

# Google Gemini API Key (Required for reasoning & embeddings)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAlex API Key (Optional, but recommended for higher rate limits during snowball search)
# Get a key at: https://openalex.org/
OPENALEX_API_KEY=your_openalex_api_key_here

# Valency MCP Endpoint (Optional, default connects to https://labs.valency.io/mcp)
VALENCY_MCP_URL=https://labs.valency.io/mcp
